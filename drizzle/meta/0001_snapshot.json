          "value": "char_length(btrim(\"todos\".\"title\")) BETWEEN 1 AND 200"
        },
        "todos_description_length_check": {
          "name": "todos_description_length_check",
          "value": "\"todos\".\"description\" IS NULL OR char_length(\"todos\".\"description\") <= 5000"
