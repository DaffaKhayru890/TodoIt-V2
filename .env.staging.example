# Salin menjadi .env.staging. Jangan pernah memakai kredensial development
# (termasuk user root / dev@123) untuk staging maupun production.
#
# DATABASE_PASSWORD dan AUTH_JWT_SECRET di bawah adalah placeholder. Nilainya
# diberikan melalui deployment environment atau secret manager, bukan lewat file
# ini. Validator menolak placeholder karena AUTH_JWT_SECRET wajib minimal 32
# karakter.
NODE_ENV=staging
APP_NAME=Todo Backend
APP_VERSION=0.1.0
APP_PORT=4000
APP_HOST=0.0.0.0
# Gunakan IANA timezone yang sesuai kebijakan operasional (contoh: Asia/Jakarta).
APP_DEFAULT_TIMEZONE=UTC

DATABASE_HOST=postgres.staging.internal
DATABASE_PORT=5432
DATABASE_USER=todo_staging_app
DATABASE_PASSWORD=__SET_VIA_SECRET_MANAGER__
DATABASE_NAME=todo_staging
DATABASE_SSL=true

# Generate: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex'))"
AUTH_JWT_SECRET=__SET_VIA_SECRET_MANAGER_MIN_32_BYTES_RANDOM___
AUTH_JWT_ISSUER=todo-backend
AUTH_JWT_AUDIENCE=todo-api

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Staging wajib HTTPS; cookie refresh token harus Secure.
AUTH_REFRESH_COOKIE_NAME=todo_refresh
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=.staging.todo-app.example

LOG_LEVEL=info
# Allowlist eksplisit; "*" ditolak validator karena API ini memakai kredensial.
CORS_ALLOWED_ORIGINS=https://staging.todo-app.example

# Undangan workspace. Development/test memakai SMTP lokal (Mailpit di Compose: host mailpit).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Todo Backend <noreply@example.com>
SMTP_SECURE=true
WEB_APP_URL=https://app.example.com
INVITATION_TOKEN_TTL_SECONDS=604800
