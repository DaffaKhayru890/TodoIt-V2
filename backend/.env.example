# =============================================================================
# TodoIt Backend — environment template
# Salin file ini menjadi .env (lokal) atau gunakan ENV_FILE.
# Jangan menaruh secret production di file ini.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=todolist
# development | test | staging | production
APP_ENV=development
APP_PORT=8080
# IANA timezone, contoh: Asia/Jakarta, UTC, America/New_York
APP_DEFAULT_TIMEZONE=Asia/Jakarta
# debug | info | warn | error
APP_LOG_LEVEL=debug
# json | text
APP_LOG_FORMAT=text
# Swagger UI di /docs. Default: true untuk development/test, false untuk staging/production.
APP_SWAGGER_ENABLED=true

# --- PostgreSQL --------------------------------------------------------------
# Langsung dari host: localhost. Di Docker Compose: postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=dev@123
DB_NAME=todolist
# disable | require | verify-ca | verify-full
DB_SSLMODE=disable
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_OPEN_CONNECTIONS=50
DB_CONNECTION_MAX_LIFETIME=30m
DB_CONNECTION_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s

# --- HTTP --------------------------------------------------------------------
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# --- CORS --------------------------------------------------------------------
# Comma-separated, origin eksplisit. Wildcard hanya boleh jika credentials=false.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# =============================================================================
# Variabel berikut baru dipakai pada phase selanjutnya dan sengaja belum dibaca
# oleh config Phase 1: JWT_*, CURSOR_SECRET, WORKER_*, SMTP_*, INVITATION_TTL.
# Jangan menambahkan secret nyata ke file template ini.
# =============================================================================
