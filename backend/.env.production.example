APP_ENV=production
APP_DEBUG=false
APP_NAME=Todo List API
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

POSTGRES_HOST=postgres-production
POSTGRES_PORT=5432
POSTGRES_DB=todo_prod_db
POSTGRES_USER=todo_app
POSTGRES_PASSWORD=replace-with-production-password

POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30
DEFAULT_TIMEZONE=UTC
AUTOMATIC_DUE_REMINDERS_ENABLED=true
DEFAULT_DUE_REMINDER_MINUTES=60
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_SECONDS=30
NOTIFICATION_BATCH_SIZE=100
OPENAPI_ENABLED=true

CORS_ORIGINS=["https://app.example.com"]
CORS_ALLOW_CREDENTIALS=true

LOG_LEVEL=INFO
LOG_FORMAT=json

JWT_SECRET_KEY=replace-with-strong-production-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

PAGINATION_CURSOR_SECRET=replace-with-strong-cursor-secret
NOTIFICATION_WORKER_SHUTDOWN_TIMEOUT_SECONDS=15
