APP_ENV=development
APP_DEBUG=true
APP_NAME=Todo List API
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=todo_db
POSTGRES_USER=root
POSTGRES_PASSWORD=dev@123

POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
DEFAULT_TIMEZONE=UTC
AUTOMATIC_DUE_REMINDERS_ENABLED=true
DEFAULT_DUE_REMINDER_MINUTES=60
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_SECONDS=30
NOTIFICATION_BATCH_SIZE=100
OPENAPI_ENABLED=true

CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

LOG_LEVEL=INFO
LOG_FORMAT=console

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

PAGINATION_CURSOR_SECRET=replace-with-strong-cursor-secret
NOTIFICATION_WORKER_SHUTDOWN_TIMEOUT_SECONDS=15
