# =============================================================================
# Staging template. Jangan isi secret nyata di file yang di-commit.
# Nilai secret harus berasal dari secret manager / environment orchestrator.
# =============================================================================
APP_NAME=todolist
APP_ENV=staging
APP_PORT=8080
APP_DEFAULT_TIMEZONE=Asia/Jakarta
APP_LOG_LEVEL=info
APP_LOG_FORMAT=json
APP_SWAGGER_ENABLED=false

DB_HOST=__STAGING_DB_HOST__
DB_PORT=5432
DB_USER=__STAGING_DB_USER__
DB_PASSWORD=__SET_FROM_SECRET_MANAGER__
DB_NAME=todolist_staging
DB_SSLMODE=require
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_OPEN_CONNECTIONS=25
DB_CONNECTION_MAX_LIFETIME=30m
DB_CONNECTION_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s

HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

CORS_ALLOWED_ORIGINS=https://staging.example.com
CORS_ALLOW_CREDENTIALS=false
