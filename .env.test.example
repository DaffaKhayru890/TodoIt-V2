# Salin menjadi .env.test lalu sesuaikan bila perlu.
NODE_ENV=test
APP_NAME=Todo Backend
APP_VERSION=0.1.0
APP_PORT=4001
APP_HOST=127.0.0.1
# Test memakai UTC agar hasil deterministik; test timezone lain mengirim query parameter.
APP_DEFAULT_TIMEZONE=UTC

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=dev@123
DATABASE_NAME=todo_test
DATABASE_SSL=false

# Secret khusus test. Test tidak pernah memakai data nyata sehingga secret tetap
# boleh berupa nilai acak yang dikomit di file contoh ini.
AUTH_JWT_SECRET=1111111111111111111111111111111111111111111111111111111111111111
AUTH_JWT_ISSUER=todo-backend
AUTH_JWT_AUDIENCE=todo-api

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

AUTH_REFRESH_COOKIE_NAME=todo_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=

LOG_LEVEL=error
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Undangan workspace. Development/test memakai SMTP lokal (Mailpit di Compose: host mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Todo Backend <noreply@localhost>
SMTP_SECURE=false
WEB_APP_URL=http://localhost:3000
INVITATION_TOKEN_TTL_SECONDS=604800

NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_INTERVAL_MS=5000
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_JOB_LEASE_SECONDS=60
NOTIFICATION_JOB_MAX_ATTEMPTS=8
NOTIFICATION_JOB_BASE_RETRY_SECONDS=5
NOTIFICATION_JOB_MAX_RETRY_SECONDS=3600
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_LOOKAHEAD_DAYS=90
TODO_DUE_SOON_OFFSETS_MINUTES=1440,60
