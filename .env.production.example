# Salin menjadi .env.production. kredensial production WAJIB terpisah dari
# development/staging dan disuntikkan melalui deployment environment atau
# secret manager. File ini tidak boleh memuat rahasia asli dan tidak di-commit.
NODE_ENV=production
APP_NAME=Todo Backend
APP_VERSION=0.1.0
APP_PORT=4000
APP_HOST=0.0.0.0

DATABASE_HOST=production.internal
DATABASE_PORT=5432
DATABASE_USER=todo_production_app
DATABASE_PASSWORD=__SET_VIA_SECRET_MANAGER__
DATABASE_NAME=todo_production
DATABASE_SSL=true

# Generate per environment (jangan pakai ulang secret staging):
# bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex'))"
AUTH_JWT_SECRET=__SET_VIA_SECRET_MANAGER_MIN_32_BYTES_RANDOM___
AUTH_JWT_ISSUER=todo-backend
AUTH_JWT_AUDIENCE=todo-api

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Production wajib HTTPS; Secure=false ditolak validator pada environment ini.
AUTH_REFRESH_COOKIE_NAME=todo_refresh
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=.todo-app.example

LOG_LEVEL=info
# Allowlist eksplisit; "*" ditolak validator karena API ini memakai kredensial.
CORS_ALLOWED_ORIGINS=https://todo-app.example
