# Salin menjadi .env.production. kredensial production WAJIB terpisah dari
# development/staging dan disuntikkan melalui deployment environment atau
# secret manager. File ini tidak boleh memuat rahasia asli dan tidak di-commit.
NODE_ENV=production
APP_NAME=Todo Backend
APP_VERSION=0.1.0
APP_PORT=4000
APP_HOST=0.0.0.0
# Gunakan IANA timezone yang sesuai kebijakan operasional (contoh: Asia/Jakarta).
APP_DEFAULT_TIMEZONE=UTC

DATABASE_HOST=production.internal
DATABASE_PORT=5432
DATABASE_USER=todo_production_app
DATABASE_PASSWORD=__SET_VIA_SECRET_MANAGER__
DATABASE_NAME=todo_production
DATABASE_SSL=true

# Generate per environment (jangan pakai ulang secret staging):
# bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex'))"
AUTH_JWT_SECRET=__SET_VIA_SECRET_MANAGER_MIN_32_BYTES_RANDOM___
AUTH_JWT_ISSUER=todo-backend
AUTH_JWT_AUDIENCE=todo-api

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Production wajib HTTPS; Secure=false ditolak validator pada environment ini.
AUTH_REFRESH_COOKIE_NAME=todo_refresh
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=.todo-app.example

LOG_LEVEL=info
# Allowlist eksplisit; "*" ditolak validator karena API ini memakai kredensial.
CORS_ALLOWED_ORIGINS=https://todo-app.example

# Undangan workspace. Development/test memakai SMTP lokal (Mailpit di Compose: host mailpit).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Todo Backend <noreply@example.com>
SMTP_SECURE=true
WEB_APP_URL=https://app.example.com
INVITATION_TOKEN_TTL_SECONDS=604800

NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_INTERVAL_MS=5000
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_JOB_LEASE_SECONDS=60
NOTIFICATION_JOB_MAX_ATTEMPTS=8
NOTIFICATION_JOB_BASE_RETRY_SECONDS=5
NOTIFICATION_JOB_MAX_RETRY_SECONDS=3600
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
NOTIFICATION_LOOKAHEAD_DAYS=90
TODO_DUE_SOON_OFFSETS_MINUTES=1440,60

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
TRUSTED_PROXY_HOPS=1
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=15000
SECURITY_HSTS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_INVITATION_PER_MINUTE=30
RATE_LIMIT_TODO_WRITE_PER_MINUTE=120
RATE_LIMIT_NOTIFICATION_PER_MINUTE=240
SMTP_CONNECTION_TIMEOUT_MS=10000
NOTIFICATION_JOB_COMPLETED_RETENTION_DAYS=14
NOTIFICATION_JOB_FAILED_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
AUTH_JWT_PREVIOUS_SECRETS=
